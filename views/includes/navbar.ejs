<style>
	.search-btn {
		background-color: #fe424d;
		color: #ffffff;
		border-radius: 25px;
		padding: 0 1rem;
	}

	.search-btn:hover {
		background-color: #fe424d;
		color: #ffffff;
	}

	.search-btn i {
		display: inline;
		margin-right: 0.5rem;
	}

	.search-inp {
		border-radius: 25px;
		padding: 0.5rem 3rem;
		font-size: 1rem;
	}
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
	<div class="container-fluid">
		<a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
		<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" id="navbarNavAltMarkup">
			<div class="navbar-nav">
				<a class="nav-link" href="/listings">Explore</a>
			</div>
			<div class="navbar-nav ms-auto">
				<form class="d-flex" role="search" method="GET" action="/listings/search">
					<input class="form-control me-2 search-inp" type="search" placeholder="Search destinations" name="location" id="searchInput"/>
					<div id="suggestions"></div>
					<button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
				</form>
			</div>
			<div class="navbar-nav ms-auto">
				<a class="nav-link" href="/listings/new">Airbnb your home</a>
				<% if(!currUser){ %>
					<a class="nav-link" href="/signup"><b>Sign up</b></a>
					<a class="nav-link" href="/login"><b>Log in</b></a>
				<% } %>
				<% if(currUser){ %>
					<a class="nav-link" href="/logout"><b>Log out</b></a>
				<% } %>
			</div>
		</div>
	</div>
</nav>

<script>
    let searchInput = document.getElementById("searchInput");
    let suggestions = document.getElementById("suggestions");

    searchInput.addEventListener("input", async () => {

        let value = searchInput.value.trim();

        if (value.length === 0) {
            suggestions.innerHTML = "";
            return;
        }

        let response = await fetch(
            `/listings/suggestions?location=${encodeURIComponent(value)}`
        );

        let locations = await response.json();

        suggestions.innerHTML = "";

        locations.forEach(location => {

            let item = document.createElement("div");

            item.innerText = location;
            item.classList.add("suggestion-item");

            item.addEventListener("click", () => {
                searchInput.value = location;
                suggestions.innerHTML = "";
            });

            suggestions.appendChild(item);
        });
    });
</script>